  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --project=ngx-ion-calendar",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage --watch=false",
    "test:watch": "ng test --code-coverage --watch=false",
